# License Server Environment Configuration

# Security - Change these in production!
SECRET_KEY=your-super-secret-key-here-change-in-production
ADMIN_API_KEY=your-admin-api-key-here-change-in-production

# Database
DATABASE_URL=sqlite:///./license_server.db

# Application
DEBUG=false
API_PREFIX=/api/v1

# License settings
DEFAULT_MAX_DEVICES=1

# Susi signing key (Phase 7.2). Resolved in this order:
#   1. SUSI_DEVELOPMENT_PRIVATE_KEY_FILE  path to a PEM file (relative paths resolve
#                                         against license_server/) -- PREFERRED
#   2. SUSI_DEVELOPMENT_PRIVATE_KEY       inline PEM, may use escaped \n
#   3. license_server/test_rsa_key.pem    developer default, when it exists
#
# Prefer the file form. A multi-line PEM does not survive a bare .env value: unquoted
# it is silently truncated to its "-----BEGIN ..." line, and a value pasted from
# PowerShell can be UTF-16, whose NUL bytes the PEM parser rejects. The key is
# development-only; production must provision its own key outside this repository.
SUSI_DEVELOPMENT_PRIVATE_KEY_FILE=test_rsa_key.pem
# SUSI_DEVELOPMENT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"