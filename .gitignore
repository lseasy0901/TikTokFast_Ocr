# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Secrets and local environment
.env
*.env
license_server/.env

# Signing key material - never commit private keys
license_server/*.pem
# Client-side verification public key (provisioned per deployment, Phase 7.2-6.5)
license_public_key.pem

# Local databases
*.db
*.sqlite
*.sqlite3
# SQLite WAL sidecar files. The `-shm` / `-wal` suffix means the `*.db` rule
# above does not match them, so they would otherwise be committed alongside a
# locally-run license server.
*.db-shm
*.db-wal

# FFmpeg companion DLL set - provisioned per machine, not versioned.
# runtime/ffmpeg/ holds ONLY ffprobe.exe (tracked) plus its av*/sw* companion
# DLLs (untracked).
# RELEASE-02-B5-CLEANUP: runtime/ffmpeg/ffmpeg.exe is gone. It was the ACLOS
# recorder's build (hard-importing libpag.dll, o264rtenc.dll, libEGL/libGLESv2
# and the MSVC runtime) and existed only for the old `_uhd` pull path; playback
# now uses the external FFmpeg 7 runtime located by utils/ffmpeg7_runtime.py.
runtime/ffmpeg/*.dll

# PP-OCRv6 production OCR model - supplied per machine, never versioned.
# runtime/ppocr/PP-OCRv6_medium_rec_infer/ is ~73 MB of weights (inference.pdiparams)
# and is provisioned by the PP-OCRv6 packaging phase, not committed. The workspace
# is checked-out-and-built, so `git add .` must not be able to sweep it in.
# douyin_viewer.spec gates the build on this directory being present.
runtime/ppocr/

# ONNX backend artifacts - supplied per machine, never versioned.
# runtime/onnx/ holds exactly two files: PP-OCRv6_medium_rec_fp32.onnx (~73 MB)
# and charset.txt (exported from the PP-OCRv6 inference.yml by
# scripts/export_onnx_charset.py). Like runtime/ppocr/, the workspace is
# checked-out-and-built, so `git add .` must not sweep them in.
# Only the ONNX source-env backend reads these; nothing frozen depends on them yet.
runtime/onnx/

# Runtime/generated files
# Release build directories carry a version suffix (build_v1.0.1/, build_v1.0.2/,
# dist_v1.0.2/). A bare `dist/` / `build/` rule matches those names only, not the
# suffixed forms, so ~868 MB of PyInstaller output sat untracked-but-not-ignored
# and would have been swept in by `git add .`. The glob form subsumes the bare
# one: `build*/` also matches a plain `build/`.
build*/
dist*/
*.log

# Local stream history
stream_history.json

# Dev-machine artifacts - never part of a release
# Screenshots taken while reviewing the UI, and debug captures of OCR output.
# The patterns stay narrow on purpose (`debug_*.png`, not `debug_*`) so they
# cannot shadow tracked source files such as debug_ocr.py.
_ui_review_*.png
debug_*.png
# Windows shortcuts embed an absolute path on the machine that created them.
*.lnk
# Local ops helper. Opens an SSH tunnel to the production admin host using a
# real host address and root login, so it stays on the dev machine and out of
# the repository. It is not part of the app and the spec never collects it.
LiveLens_Admin.bat
# Same reasoning for the download-link updater: it logs into the production
# host as root over SSH to rewrite the site's release links. Anchored to the
# repo root so only this one file is matched.
/更新LiveLens下载链接.bat
# Local-only authorisation module. It carries the built-in offline key pool,
# which must not be published alongside the source. Anchored for the same
# reason -- a same-named module elsewhere would stay visible.
/utils/offline_activation.py
# UI review screenshots: the directory form of the _ui_review_*.png rule above.
/ui_screenshots/
# Real ROI sample captures (ocr/sample_capture.py). Default output lives in the
# user's Documents folder, but the directory is configurable and a dev run can
# point it here. Machine-specific pixels, never project content.
/ocr_samples/
# Stray redirect targets: an empty file, and one holding the output of
# `git diff --stat` written under an option string. Neither is project content.
/bool
/-files --others --exclude-standard

# OS/editor
Thumbs.db
.DS_Store
.vscode/
.idea/

# Rust
target/

# Vendored third-party admin UI (upstream sqladmin snapshot, not project source)
# Both the extracted tree and its archive form.
admin_web/
admin_web.zip
